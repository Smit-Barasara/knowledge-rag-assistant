    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
